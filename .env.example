# Required for the websocket gateway; replace with a unique random value.
NIX_AUTH_TOKEN=replace-with-a-local-secret

# Service bindings
NIX_WS_HOST=127.0.0.1
NIX_WS_PORT=9000
NIX_KNOWLEDGE_API_HOST=127.0.0.1
NIX_KNOWLEDGE_API_PORT=8100
NIX_ACTIONS_API_HOST=127.0.0.1
NIX_ACTIONS_API_PORT=8200

# Runtime data (ignored by git)
NIX_DATA_DIR=./data
# NIX_KNOWLEDGE_DB=./data/knowledge.db
# NIX_ACTIONS_DB=./data/actions.db
# NIX_CORE_DB=./data/nix_core.db

# Optional downstream chat service
# NIX_OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# NIX_OLLAMA_MODEL=qwen3.5:4b
# NIX_OLLAMA_THINK=0
# NIX_OLLAMA_FALLBACK_MODEL=phi4-mini:latest
# NIX_OLLAMA_NUM_CTX=8192
# NIX_OLLAMA_NUM_BATCH=128
# NIX_OLLAMA_KEEP_ALIVE=5m
# Optional TabbyAPI/ExLlama backend. Select only after loading a verified
# Qwen-compatible EXL2/EXL3 artifact in TabbyAPI.
# NIX_CASPER_BACKEND=tabby
# NIX_TABBY_API_URL=http://127.0.0.1:5000/v1/chat/completions
# NIX_TABBY_MODEL=casper-puca-v5
# NIX_TABBY_API_KEY=
# NIX_KNOWLEDGE_MODEL_GATE=1
# NIX_KNOWLEDGE_VRAM_FRACTION=0.30
# NIX_CASPER_MAX_CONCURRENT_REQUESTS=1
# NIX_CONTEXT_WINDOW=24
# NIX_CONTEXT_MAX_CHARS=16000

NIX_TZ=America/Chicago
