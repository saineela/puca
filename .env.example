# Required for the websocket gateway; replace with a unique random value.
NIX_AUTH_TOKEN=replace-with-a-local-secret

# Service bindings
# PUCA Panel: the wall display for the music a provider skill serves. Its own
# fixed port beside the console's 49117, so a display can be pointed at it once.
# The TLS port serves the same display and exists for the microphone: a browser
# only lends a page one on a secure origin. Its certificate is self-signed and
# generated once into the data directory.
NIX_PANEL_HOST=0.0.0.0
NIX_PANEL_PORT=49170
NIX_PANEL_TLS_PORT=49171
# Speech to text on this machine, behind the music pages' microphone
# (GET /api/voice). Whisper, recognised locally, never uploaded. "auto" uses the
# graphics card only when it has room, so the chat model is not evicted.
NIX_STT_MODEL=openai/whisper-small.en
NIX_STT_DEVICE=auto
# NIX_STT_LANGUAGE=en
NIX_WS_HOST=127.0.0.1
NIX_WS_PORT=9000
NIX_KNOWLEDGE_API_HOST=127.0.0.1
NIX_KNOWLEDGE_API_PORT=8100
NIX_ACTIONS_API_HOST=127.0.0.1
NIX_ACTIONS_API_PORT=8200
# The music queue's own service (nix_core/music_queue_service.py): the play
# queue lives here rather than in the music skill, so a playlist of any length
# is stored once and read in windows, and the tracks ahead of the cursor are
# warmed in the background at the rate the OpenDeck instance declares. The
# console and the provider skill both read NIX_MUSIC_QUEUE_URL: with it set they
# use this service, and with it unset the queue stays in the skill exactly as
# before.
NIX_MUSIC_QUEUE_PORT=49119
NIX_MUSIC_QUEUE_DB=./data/music-queue.db
# NIX_MUSIC_QUEUE_URL=http://127.0.0.1:49119
# NIX_MUSIC_QUEUE_TOKEN=set-a-secret-when-the-service-is-not-loopback-only
# NIX_MUSIC_QUEUE_TICK=1.0

# Runtime data (ignored by git)
NIX_DATA_DIR=./data
# NIX_KNOWLEDGE_DB=./data/knowledge.db
# NIX_ACTIONS_DB=./data/actions.db
# NIX_CORE_DB=./data/nix_core.db

# Optional downstream chat service
# NIX_OLLAMA_API_URL=http://127.0.0.1:11434/api/chat
# NIX_OLLAMA_MODEL=qwen3.5:4b
# NIX_OLLAMA_THINK=0
# NIX_OLLAMA_FALLBACK_MODEL=phi4-mini:latest
# NIX_OLLAMA_NUM_CTX=8192
# NIX_OLLAMA_NUM_BATCH=128
# NIX_OLLAMA_KEEP_ALIVE=5m
# Dedicated proposal-only device planner (separate from Luna/chat).
# Needle 3 engine + base Needle3-20L-121M weights are cached locally; telemetry is disabled.
NIX_SKILL_PLANNER_MODEL=Needle3-20L-121M
# Optional TabbyAPI/ExLlama backend. Select only after loading a verified
# Qwen-compatible EXL2/EXL3 artifact in TabbyAPI.
# NIX_CASPER_BACKEND=tabby
# Limit ordinary Casper replies to a smaller decoding budget. Complex turns
# retain CASPER_MAX_NEW_TOKENS; this reduces latency on short PUCA dialogue.
# CASPER_FAST_MAX_NEW_TOKENS=64
# NIX_TABBY_API_URL=http://127.0.0.1:5000/v1/chat/completions
# NIX_TABBY_MODEL=casper-puca-v5
# NIX_TABBY_API_KEY=
# Keep the Qwen 2.5 0.5B selector disabled by default. Core's symbolic
# router plus Knowledge parser handle high-confidence requests without a
# second GPU model. Set to 1 only for an explicit predictor experiment.
NIX_CORE_USE_KNOWLEDGE_MODEL_GATE=0
# Optional CPU-first tiny route predictor (no CUDA/VRAM).
NIX_CORE_USE_CUSTOM_ROUTING_PREDICTOR=1
# NIX_ROUTING_PREDICTOR_PATH=/absolute/path/to/routing_predictor.npz
# NIX_KNOWLEDGE_VRAM_FRACTION=0.30
# OpenAI-compatible API (Open WebUI/SDK clients)
# NIX_OPENAI_API_KEY=set-a-secret-for-external-clients
# NIX_OPENAI_API_ALLOW_ORIGIN=*
# NIX_CASPER_MAX_CONCURRENT_REQUESTS=1
# Casper fallback adapter paths only. The official Transformers selector
# starts with Luna V6; Casper fallbacks are selected explicitly in the dashboard
# and switch exclusively at runtime, unloading the prior adapter.
# NIX_CASPER_MODEL=casper-puca-qlora-v5
# CASPER_V5_ADAPTER_PATH=./nix_knowledge/models/nixlm/casper-puca-qlora-v5
# CASPER_V6_ADAPTER_PATH=./nix_knowledge/models/nixlm/casper-puca-qlora-v6-final
# NIX_CONTEXT_WINDOW=24
# Casper thinking is permanently disabled; this remains explicit for
# compatible deployments and is not an opt-in switch.
NIX_CASPER_THINKING=0
# Luna Pro v1 is retired: its research artifacts are archived, but it has no
# runtime/load path. Do not reuse its training approach or data for any model.
# Luna development is V6-only; no Luna training is authorized.
# Optional local artifact paths for Luna V6 inference only:
# LUNA_BASE_MODEL_PATH=./nix_knowledge/models/llama-3.2-3b-unsloth-instruct
# LUNA_V6_ADAPTER_PATH=./nix_knowledge/models/nixlm/luna-v6-contextual-v1/checkpoint-60
# LUNA_VRAM_FRACTION=0.48

NIX_TZ=America/Chicago
